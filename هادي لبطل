-- Script Name: هادي لبطل
-- Target Game: Blade Ball (كرة الشفرة)
-- Executor: Delta
-- Feature: زر تشغيل وإيقاف (ON/OFF GUI)
-- =======================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local ScriptTitle = "هادي لبطل"
local AutoParry = true
local DistanceMultiplier = 0.65

-- إنشاء واجهة المستخدم (GUI)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HadiHeroGui"
ScreenGui.ResetOnSpawn = false

if gethui then
    ScreenGui.Parent = gethui()
elseif syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
else
    ScreenGui.Parent = CoreGui or LocalPlayer:WaitForChild("PlayerGui")
end

-- تصميم زر الإيقاف والتشغيل
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleButton.BorderSizePixel = 0
ToggleButton.Position = UDim2.new(0.05, 0, 0.2, 0)
ToggleButton.Size = UDim2.new(0, 150, 0, 45)
ToggleButton.Font = Enum.Font.SourceSansBold
ToggleButton.Text = ScriptTitle .. "\n[ مفعل 🟢 ]"
ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 127)
ToggleButton.TextSize = 16
ToggleButton.Active = true
ToggleButton.Draggable = true -- تحريك الزر في أي مكان بالمس بالنقر والسحب

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = ToggleButton

local UIStroke = Instance.new("UIStroke")
UIStroke.Thickness = 2
UIStroke.Color = Color3.fromRGB(0, 255, 127)
UIStroke.Parent = ToggleButton

-- وظيفة التشغيل والإيقاف عند النقر
ToggleButton.MouseButton1Click:Connect(function()
    AutoParry = not AutoParry
    if AutoParry then
        ToggleButton.Text = ScriptTitle .. "\n[ مفعل 🟢 ]"
        ToggleButton.TextColor3 = Color3.fromRGB(0, 255, 127)
        UIStroke.Color = Color3.fromRGB(0, 255, 127)
    else
        ToggleButton.Text = ScriptTitle .. "\n[ معطل 🔴 ]"
        ToggleButton.TextColor3 = Color3.fromRGB(255, 65, 65)
        UIStroke.Color = Color3.fromRGB(255, 65, 65)
    end
end)

-- تحديد مكان الكرة
local function GetActiveBall()
    local ballsFolder = workspace:FindFirstChild("Balls")
    if not ballsFolder then return nil end
    
    for _, ball in pairs(ballsFolder:GetChildren()) do
        if ball:GetAttribute("realBall") == true or ball:FindFirstChild("zoomies") or ball.Name == "Ball" then
            return ball
        end
    end
    return nil
end

-- تنفيذ ضغطة التصدّي
local function ExecuteParry()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.001)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- الحلقة الرئيسية للتصدّي السريع
RunService.PreRender:Connect(function()
    if not AutoParry then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local ball = GetActiveBall()
    
    if ball then
        local ballPos = ball.Position
        local playerPos = hrp.Position
        local distance = (ballPos - playerPos).Magnitude
        
        local velocity = ball.AssemblyLinearVelocity
        local speed = velocity.Magnitude
        
        local directionToPlayer = (playerPos - ballPos).Unit
        local ballDirection = velocity.Unit
        local dotProduct = directionToPlayer:Dot(ballDirection)
        
        local isTargeted = (ball:GetAttribute("target") == LocalPlayer.Name) or (dotProduct > 0.35)
        local dynamicTriggerDistance = math.clamp(speed * DistanceMultiplier, 12, 120)
        
        if isTargeted and distance <= dynamicTriggerDistance then
            ExecuteParry()
        end
    end
end)
