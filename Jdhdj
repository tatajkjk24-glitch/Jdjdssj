-- تشغيل السكربت الخارجي
local function RunScript(title, url)
    task.spawn(function()
        local ok, result = pcall(function()
            local source = game:HttpGet(url)
            assert(type(source) == "string" and #source > 0, "تعذر تحميل السكربت")

            local fn = loadstring(source)
            assert(type(fn) == "function", "السكربت المحمل غير صالح")

            return fn()
        end)

        if ok then
            Notify(title, "تم تشغيل السكربت بنجاح ✅")
        else
            warn("[KHITAM HUB] "..title.." -> "..tostring(result))
            Notify(title, "حدث خطأ أثناء تشغيل السكربت ❌")
        end
    end)
end

local function AddScriptButton(tab, title, description, url, notifyTitle)
    tab:AddButton({
        Title = title,
        Description = description,

        Callback = function()
            RunScript(notifyTitle or title, url)
        end
    })
end

