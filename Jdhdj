local WalkSpeed = 16
local JumpPower = 50

local function GetCharacterHumanoid()
    local character = Players.LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

Tabs.Player:AddSlider("WalkSpeed", {
    Title = "WalkSpeed",
    Description = "سرعة اللاعب",
    Default = 16,
    Min = 0,
    Max = 200,
    Rounding = 0,

    Callback = function(value)
        WalkSpeed = value

        local humanoid = GetCharacterHumanoid()

        if humanoid then
            humanoid.WalkSpeed = value
        end
    end
})

Tabs.Player:AddSlider("JumpPower", {
    Title = "JumpPower",
    Description = "قوة القفز",
    Default = 50,
    Min = 0,
    Max = 200,
    Rounding = 0,

    Callback = function(value)
        JumpPower = value

        local humanoid = GetCharacterHumanoid()

        if humanoid then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = value
        end
    end
})

Tabs.Player:AddToggle("InfJump", {
    Title = "InfJump",
    Description = "قفز لا نهائي",
    Default = false
}):OnChanged(function(enabled)

    if enabled then

        if not _G.KHITAM_InfJumpConnection then

            _G.KHITAM_InfJumpConnection =
                game:GetService("UserInputService").JumpRequest:Connect(function()

                    local humanoid = GetCharacterHumanoid()

                    if humanoid then
                        humanoid:ChangeState(
                            Enum.HumanoidStateType.Jumping
                        )
                    end

                end)

        end

    else

        if _G.KHITAM_InfJumpConnection then
            _G.KHITAM_InfJumpConnection:Disconnect()
            _G.KHITAM_InfJumpConnection = nil
        end

    end

end)

Players.LocalPlayer.CharacterAdded:Connect(function(character)

    local humanoid = character:WaitForChild("Humanoid", 10)

    if humanoid then
        humanoid.WalkSpeed = WalkSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = JumpPower
    end

end)

