local scriptStartTime = os.time()

local playerData = {}

local function registerPlayer(player)

    playerData[player.UserId] = {

        joinTime = os.time(),

        totalTime = 0,

        leaves = 0,

        isOnline = true

    }

end

local function getPlayerTotalTime(userId)

    local info = playerData[userId]

    if not info then
        return 0
    end

    local total = info.totalTime or 0

    if info.isOnline and info.joinTime then

        total =
            total +
            (os.time() - info.joinTime)

    end

    return total
end

for _, player in ipairs(Players:GetPlayers()) do
    registerPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
    registerPlayer(player)
end)

local trackerParagraph =
    Tabs.Tracker:AddParagraph({

        Title = "الوقت المنقضي",

        Content = "جاري الحساب..."

    })

task.spawn(function()

    while task.wait(1) do

        local elapsed =
            os.time() - scriptStartTime

        trackerParagraph:SetDesc(

            string.format(

                "الوقت المنقضي: %02d:%02d:%02d",

                math.floor(elapsed / 3600),

                math.floor(
                    (elapsed % 3600) / 60
                ),

                elapsed % 60

            )

        )

    end

end)

local targetPlayerName = ""

Tabs.Tracker:AddInput("SearchUser", {

    Title = "اسم اللاعب",

    Default = "",

    Placeholder = "اكتب اسم اللاعب...",

    Numeric = false,

    Finished = false,

    Callback = function(value)

        targetPlayerName =
            tostring(value or "")

    end

})

local leaveSound = Instance.new("Sound")

leaveSound.SoundId =
    "rbxassetid://138081509"

leaveSound.Volume = 10

leaveSound.Parent =
    game:GetService("SoundService")

local trackedParagraph = nil

Tabs.Tracker:AddButton({

    Title = "تتبع اللاعب",

    Description =
        "يعرض تفاصيل الدخول والخروج والمدة",

    Callback = function()

        if targetPlayerName == "" then

            Notify(
                "التتبع",
                "اكتب اسم اللاعب أولاً"
            )

            return
        end

        local foundPlayer = nil

        local wanted =
            string.lower(targetPlayerName)

        for _, player in ipairs(
            Players:GetPlayers()
        ) do

            if string.lower(player.Name) == wanted
                or string.lower(player.DisplayName) == wanted then

                foundPlayer = player

                break
            end

        end

        if not foundPlayer then

            Notify(
                "التتبع",
                "اللاعب غير موجود حالياً"
            )

            return
        end

        if trackedParagraph then

            pcall(function()

                trackedParagraph:Destroy()

            end)

            trackedParagraph = nil

        end

        trackedParagraph =
            Tabs.Tracker:AddParagraph({

                Title =
                    "تتبع: "
                    .. foundPlayer.Name,

                Content =
                    "جاري جلب البيانات..."

            })

        task.spawn(function()

            while foundPlayer
                and foundPlayer.Parent do

                local info =
                    playerData[
                        foundPlayer.UserId
                    ]

                if info then

                    local total =
                        getPlayerTotalTime(
                            foundPlayer.UserId
                        )

                    trackedParagraph:SetDesc(

                        string.format(

                            "وقت الدخول: %s\nمدة اللعب: %02d:%02d:%02d\nمرات الخروج: %d",

                            os.date(
                                "%H:%M:%S",
                                info.joinTime
                            ),

                            math.floor(
                                total / 3600
                            ),

                            math.floor(
                                (total % 3600) / 60
                            ),

                            total % 60,

                            info.leaves or 0

                        )

                    )

                end

                task.wait(1)

            end

        end)

        Notify(
            "تتبع اللاعبين",
            "تم بدء تتبع "
            .. foundPlayer.Name
        )

    end

})

Players.PlayerRemoving:Connect(function(player)

    local info =
        playerData[player.UserId]

    if info then

        if info.isOnline
            and info.joinTime then

            info.totalTime =
                (info.totalTime or 0)
                + (
                    os.time()
                    - info.joinTime
                )

        end

        info.isOnline = false

        info.leaves =
            (info.leaves or 0) + 1

    end

    if string.lower(targetPlayerName)
        == string.lower(player.Name) then

        pcall(function()
            leaveSound:Play()
        end)

        Notify(
            "خروج لاعب",
            player.Name
            .. " خرج من اللعبة 🚪"
        )

    end

end)

