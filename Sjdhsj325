    Finished = false,
    Callback = function(Value)
        targetDmrName = Value
    end
})

local function getDmrPlayer()
    if targetDmrName == "" then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (plr.Name:lower():find(targetDmrName:lower()) or plr.DisplayName:lower():find(targetDmrName:lower())) then
            return plr
        end
    end
    return nil
end

local function stopBang()
    isBanging = false
    if bangThread then
        task.cancel(bangThread)
        bangThread = nil
    end
    if bangAnimationTrack then
        bangAnimationTrack:Stop()
        bangAnimationTrack = nil
    end
end

local function startBang(typeMode)
    stopBang()
    local target = getDmrPlayer()
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("Humanoid") or not myChar:FindFirstChild("HumanoidRootPart") then return end

    isBanging = true

    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = (myChar.Humanoid.RigType == Enum.HumanoidRigType.R15) and "rbxassetid://148840371" or "rbxassetid://148880882"
        bangAnimationTrack = myChar.Humanoid:LoadAnimation(anim)
        bangAnimationTrack:Play(0.01, 1, 10)
        bangAnimationTrack:AdjustSpeed(10)
    end)

    bangThread = task.spawn(function()
        local toggleDist = false

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if not isBanging then
                connection:Disconnect()
                return
            end

            local targetChar = target.Character
            myChar = LocalPlayer.Character

            if myChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                local myHRP = myChar.HumanoidRootPart
                local targetHRP = targetChar.HumanoidRootPart
                
                toggleDist = not toggleDist

                local offset = CFrame.new(0, 0, 0)

                if typeMode == "normal" then
                    local pushOffset = toggleDist and -0.8 or -2.5
                    offset = CFrame.new(0, 0, pushOffset)
                elseif typeMode == "head" then
                    local pushOffset = toggleDist and 0.8 or 2.5
                    offset = CFrame.new(0, pushOffset, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                elseif typeMode == "front" then
                    local pushOffset = toggleDist and 0.8 or 2.5
                    offset = CFrame.new(0, 0, pushOffset) * CFrame.Angles(0, math.rad(180), 0)
                elseif typeMode == "fling" then
                    myHRP.Velocity = Vector3.new(20000, 20000, 20000)
                    myHRP.RotVelocity = Vector3.new(20000, 20000, 20000)
                    offset = CFrame.new(math.random(-1, 1), 0, math.random(-1, 1))
                end

                myHRP.CFrame = targetHRP.CFrame * offset
            else
                stopBang()
                if connection then connection:Disconnect() end
            end
        end)
    end)
end

