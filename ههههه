-- 3. الربط مع نظام شات روبلكس الأصلي (إرسال واستقبال)
-- ============================================================

-- أ) الاستقبال من TextChatService (النظام الجديد)
pcall(function()
    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.MessageReceived:Connect(function(textChatMessage)
            if textChatMessage and textChatMessage.TextSource then
                local senderPlayer = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
                if senderPlayer then
                    displayChatMessage(senderPlayer.DisplayName .. " (@" .. senderPlayer.Name .. ")", textChatMessage.Text)
                end
            elseif textChatMessage and textChatMessage.PrefixText ~= "" then
                displayChatMessage("النظام", textChatMessage.Text, "FFFF55")
            end
        end)
    end
end)

-- ب) الاستقبال من Legacy Chat (النظام القديم)
pcall(function()
    local DefaultChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if DefaultChatEvents then
        local OnMessageDoneFiltering = DefaultChatEvents:FindFirstChild("OnMessageDoneFiltering")
        if OnMessageDoneFiltering then
            OnMessageDoneFiltering.OnClientEvent:Connect(function(messageData)
                if messageData and messageData.FromSpeaker and messageData.Message then
                    local senderName = messageData.FromSpeaker
                    local plr = Players:FindFirstChild(senderName)
                    local displayName = plr and (plr.DisplayName .. " (@" .. plr.Name .. ")") or senderName
                    displayChatMessage(displayName, messageData.Message)
                end
            end)
        end
    end
end)

-- ج) الاستقبال الاحتياطي المباشر من اللاعبين
local function hookPlayerChat(plr)
    plr.Chatted:Connect(function(msg)
        local nameTag = plr.DisplayName .. " (@" .. plr.Name .. ")"
        displayChatMessage(nameTag, msg)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        hookPlayerChat(plr)
    end
end
Players.PlayerAdded:Connect(hookPlayerChat)

-- د) دالة الإرسال للسيرفر الشاملة
local function sendChatMessage(msgText)
    if not msgText or msgText:match("^%s*$") then return end
    
    local sentSuccessfully = false

    -- تجربة الإرسال عبر TextChatService
    pcall(function()
        if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannels = TextChatService:FindFirstChild("TextChannels", true)
            local generalChannel = textChannels and textChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(msgText)
                sentSuccessfully = true
            end
        end
    end)

    -- تجربة الإرسال عبر Legacy Chat
    if not sentSuccessfully then
        pcall(function()
            local DefaultChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            local SayMessageRequest = DefaultChatEvents and DefaultChatEvents:FindFirstChild("SayMessageRequest")
            if SayMessageRequest then
                SayMessageRequest:FireServer(msgText, "All")
                sentSuccessfully = true
            end
        end)
    end

    -- طباعة الرسالة محلياً فور الإرسال
    displayChatMessage(LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")", msgText)
end

-- عند كتابة النص والضغط على Enter
TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = TextBox.Text
        TextBox.Text = ""
        sendChatMessage(text)
    end
end)

