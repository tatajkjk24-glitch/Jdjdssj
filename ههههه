-- دالة عرض الرسالة في القائمة
local function addMessage(sender, text)
    local lbl = Instance.new("TextLabel", MessageLog)
    lbl.Size = UDim2.new(1, 0, 0, 18)
    lbl.BackgroundTransparency = 1
    -- تلوين اسمك بالأخضر وأسماء الآخرين بالأبيض
    lbl.TextColor3 = (sender == LocalPlayer.Name) and Color3.fromRGB(85, 255, 127) or Color3.fromRGB(255, 255, 255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 14
    lbl.Text = "[" .. sender .. "]: " .. text
    MessageLog.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
    MessageLog.CanvasPosition = Vector2.new(0, MessageLog.AbsoluteCanvasSize.Y)
end

-- 1. دالة إرسال الشات للجميع (يدعم النظامين)
local function sendMessage(msg)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local rbxGeneral = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if rbxGeneral then
                rbxGeneral:SendAsync(msg)
            end
        else
            local SayMessage = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if SayMessage then
                SayMessage:FireServer(msg, "All")
            end
        end
    end)
end

-- 2. دالة استقبال رسائل باقي اللاعبين
pcall(function()
    if TextChatService.TextChannels:FindFirstChild("RBXGeneral") then
        TextChatService.TextChannels.RBXGeneral.MessageReceived:Connect(function(textChatMessage)
            if textChatMessage.TextSource then
                local plr = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
                if plr then
                    addMessage(plr.Name, textChatMessage.Text)
                end
            end
        end)
    end
end)

local function listenToPlayer(player)
    player.Chatted:Connect(function(msg)
        if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
            addMessage(player.Name, msg)
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    listenToPlayer(p)
end
Players.PlayerAdded:Connect(listenToPlayer)

-- عند كتابة النص والضغط على Enter
TextBox.FocusLost:Connect(function(enter)
    if enter and TextBox.Text ~= "" then
        sendMessage(TextBox.Text)
        TextBox.Text = ""
    end
end)

addMessage("تيم التائبون", "تم تفعيل الاستقبال والإرسال المباشر للجميع!")
