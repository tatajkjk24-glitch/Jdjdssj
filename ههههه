-- 6. دالة طباعة الرسائل وتصفية تنبيهات النظام
local recentMsgs = {}
local function PrintMessage(senderName, text, isSystem)
    if not text or text:match("^%s*$") then return end

    -- فلترة ومنع إظهار تحذيرات روبلوكس الخاصة بالإعدادات
    if text:find("إعدادات الدردشة لديك") or text:find("your chat settings") or text:find("prevent you from") then
        return
    end

    local msgKey = senderName .. ":" .. text
    if recentMsgs[msgKey] and (tick() - recentMsgs[msgKey]) < 0.4 then
        return
    end
    recentMsgs[msgKey] = tick()

    local lbl = Instance.new("TextLabel", MessageLog)
    lbl.Size = UDim2.new(1, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.RichText = true
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 15
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true

    if isSystem then
        lbl.Text = string.format("<font color='#FFE600'>[النظام]: %s</font>", text)
    else
        local isMe = (senderName == LocalPlayer.Name or senderName == LocalPlayer.DisplayName)
        local color = isMe and "#55FF7F" or "#00E5FF"
        lbl.Text = string.format("<font color='%s'>[%s]:</font> %s", color, senderName, text)
    end

    lbl.AutomaticSize = Enum.AutomaticSize.Y

    task.defer(function()
        MessageLog.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
        MessageLog.CanvasPosition = Vector2.new(0, UIList.AbsoluteContentSize.Y + 999)
    end)
end

-- 7. استقبال الرسائل من السيرفر وباقي اللاعبين
pcall(function()
    TextChatService.MessageReceived:Connect(function(msg)
        if msg and msg.TextSource then
            local plr = Players:GetPlayerByUserId(msg.TextSource.UserId)
            if plr then
                PrintMessage(plr.DisplayName, msg.Text)
            end
        end
    end)
end)

task.spawn(function()
    pcall(function()
        local chatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 3)
        if chatEvents then
            local onMsg = chatEvents:WaitForChild("OnMessageDoneFiltering", 3)
            if onMsg then
                onMsg.OnClientEvent:Connect(function(data)
                    if data and data.FromSpeaker and data.Message then
                        local plr = Players:FindFirstChild(data.FromSpeaker)
                        local name = plr and plr.DisplayName or data.FromSpeaker
                        PrintMessage(name, data.Message)
                    end
                end)
            end
        end
    end)
end)

local function hookPlayer(plr)
    plr.Chatted:Connect(function(msg)
        if plr ~= LocalPlayer then
            PrintMessage(plr.DisplayName, msg)
        end
    end)
end
for _, plr in ipairs(Players:GetPlayers()) do
    hookPlayer(plr)
end
Players.PlayerAdded:Connect(hookPlayer)

-- 8. دالة الإرسال مع الطباعة المحلية الفورية
local function SendMessage()
    local text = TextBox.Text
    if not text or text:match("^%s*$") then return end
    TextBox.Text = ""

    -- عرض الرسالة محلياً فوراً في قائمتك
    PrintMessage(LocalPlayer.DisplayName, text)

    -- إرسال الرسالة إلى قنوات روبلوكس بدون إظهار أخطاء النظام
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            local mainChannel = channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildOfClass("TextChannel")
            if mainChannel then
                mainChannel:SendAsync(text)
            end
        end
    end)

    pcall(function()
        local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local sayReq = events and events:FindFirstChild("SayMessageRequest")
        if sayReq then
            sayReq:FireServer(text, "All")
        end
    end)
end

SendBtn.MouseButton1Click:Connect(SendMessage)
TextBox.FocusLost:Connect(function(enter)
    if enter then SendMessage() end
end)

