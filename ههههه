-- دالة طباعة الرسائل بتنسيق روبلكس الأصلي
local processedMessages = {}

local function displayChatMessage(speakerName, text, customColor)
    if not text or text == "" then return end
    
    -- تجنب تكرار الرسالة ذاتها في نفس اللحظة
    local msgKey = speakerName .. ":" .. text
    if processedMessages[msgKey] and (tick() - processedMessages[msgKey]) < 0.5 then
        return
    end
    processedMessages[msgKey] = tick()

    local nameColorHex = "55FFFF"
    if speakerName:find(LocalPlayer.Name) or speakerName:find(LocalPlayer.DisplayName) then
        nameColorHex = "55FF7F" -- لون أخضر للاعب الحالي
    elseif customColor then
        nameColorHex = customColor
    end

    local msgLabel = Instance.new("TextLabel", MessageLog)
    msgLabel.Size = UDim2.new(1, 0, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.RichText = true
    msgLabel.Font = Enum.Font.SourceSans
    msgLabel.TextSize = 15
    msgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Text = string.format("<font color='#%s'><b>[%s]:</b></font> %s", nameColorHex, speakerName, text)

    -- ضبط الارتفاع تلقائياً حسب طول النص
    msgLabel.AutomaticSize = Enum.AutomaticSize.Y

    -- التمرير للأسفل تلقائياً
    task.defer(function()
        MessageLog.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
        MessageLog.CanvasPosition = Vector2.new(0, UIListLayout.AbsoluteContentSize.Y + 1000)
    end)
end

