local isHidden = false

-- وظيفة الإخفاء والإظهار عند الضغط
ToggleBtn.MouseButton1Click:Connect(function()
    local targetGui = LocalPlayer.PlayerGui:FindFirstChild("VoltaireGhanamiVersion")
    if not targetGui then return end
    
    local mainFrame = targetGui:FindFirstChildOfClass("Frame")
    if not mainFrame then return end

    isHidden = not isHidden

    -- البحث عن أزرار والنصوص الخاصة بالتعديل وإخفائها
    for _, child in ipairs(mainFrame:GetChildren()) do
        -- رصد أزرار (+) و (-) والنصوص التابعة لها
        if child:IsA("TextButton") and (child.Text == "+" or child.Text == "-") then
            child.Visible = not isHidden
        elseif child:IsA("TextLabel") and string.find(child.Text, "نقاط") then
            child.Visible = not isHidden
        end
    end

    -- تغيير نص وتأثير الزر العائم
    if isHidden then
        ToggleBtn.Text = "👁️ إظهار النقاط"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        ToggleBtn.Text = "👁️ إخفاء النقاط"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    end
end)
