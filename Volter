-- دالة تحديث السجل اللحظي
local function forceUpdateUI()
    for _, child in ipairs(ScrollList:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    for userId, data in pairs(playerScores) do
        local Card = Instance.new("TextLabel")
        Card.Parent = ScrollList
        Card.Size = UDim2.new(1, 0, 0, 40)
        Card.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
        Card.TextColor3 = Color3.fromRGB(255, 50, 50) -- لون النص أحمر مميز
        Card.Font = Enum.Font.SourceSansBold
        Card.TextSize = 14
        Card.Text = string.format(" 🎯 الخصم: %s\n 📤 خروج: %d", data.name, data.leaveCount * leavePts)
    end
end

-- أزرار التحكم بالنقاط (+ و -)
local function createLeaveCounter(yPos, labelText, defaultVal, callback)
    local val = defaultVal
    local label = Instance.new("TextLabel")
    label.Parent = MainFrame
    label.Position = UDim2.new(0.05, 0, yPos, 0)
    label.Size = UDim2.new(0.5, 0, 0, 30)
    label.Text = labelText .. ": " .. val
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.SourceSansBold

    local minusBtn = Instance.new("TextButton")
    minusBtn.Parent = MainFrame
    minusBtn.Position = UDim2.new(0.6, 0, yPos, 0)
    minusBtn.Size = UDim2.new(0.15, 0, 0, 30)
    minusBtn.Text = "-"
    minusBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

    local plusBtn = Instance.new("TextButton")
    plusBtn.Parent = MainFrame
    plusBtn.Position = UDim2.new(0.78, 0, yPos, 0)
    plusBtn.Size = UDim2.new(0.15, 0, 0, 30)
    plusBtn.Text = "+"
    plusBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

    minusBtn.MouseButton1Click:Connect(function()
        if val > 0 then
            val = val - 1
            label.Text = labelText .. ": " .. val
            callback(val)
            forceUpdateUI()
        end
    end)

    plusBtn.MouseButton1Click:Connect(function()
        val = val + 1
        label.Text = labelText .. ": " .. val
        callback(val)
        forceUpdateUI()
    end)
end

createLeaveCounter(0.28, "نقاط الخروج", leavePts, function(v) leavePts = v end)

-- عند ضغط زر "تفعيل / شغال ✅"
StartBtn.MouseButton1Click:Connect(function()
    targetPrefix = NameInput.Text:lower():gsub("%s+", "")
    if #targetPrefix >= 1 then
        isTracking = true
        StartBtn.Text = "شغال ✅"
        StartBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        
        for _, p in ipairs(Players:GetPlayers()) do
            local name = p.Name:lower()
            local display = p.DisplayName:lower()
            if name:find(targetPrefix, 1, true) or display:find(targetPrefix, 1, true) then
                playerScores[p.UserId] = { name = p.Name, leaveCount = 1 }
            end
        end
        forceUpdateUI()
    end
end)

-- رصد الخروج الفوري
Players.PlayerRemoving:Connect(function(player)
    if not isTracking then return end
    if playerScores[player.UserId] then
        playerScores[player.UserId].leaveCount = playerScores[player.UserId].leaveCount + 1
        forceUpdateUI()
    end
end)
